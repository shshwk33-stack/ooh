{
  "name": "transit-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.dashboard.config.js",
    "build": "vite build --config vite.dashboard.config.js",
    "preview": "vite preview --config vite.dashboard.config.js",
    "test": "node --test --test-isolation=none tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "dev:legacy": "vite --host 0.0.0.0 --port 5182",
    "build:legacy": "vite build",
    "preview:legacy": "vite preview --host 0.0.0.0 --port 5183",
    "test:dashboard": "node dashboard/tests/browser.mjs",
    "test:connected": "node dashboard/tests/research-browser.mjs",
    "test:demo": "node --test --test-isolation=none dashboard/tests/*.test.js",
    "build:standalone": "npm run build && node dashboard/scripts/build-standalone.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-kr": "^5.3.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "vite": "^6.4.1"
  }
}
